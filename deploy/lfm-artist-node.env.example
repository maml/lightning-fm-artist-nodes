# Lightning FM :: artist node production config
#
# install.sh copies this to /etc/lfm-artist-node.env (root:root, mode 600).
# Fill in every var, then: sudo systemctl start lfm-artist-node
#
# This file holds your seed. Never commit it, never loosen its permissions.
# Full documentation for each var: README.md, "Configuration" section.
# The data directory is set by the systemd unit, not here.

# Display name, used in invoice descriptions and logs.
ARTIST_NAME="Your Artist Name"

# bitcoin for production. The built-in default is signet, so set this.
NETWORK="bitcoin"

# BIP39 seed for the node wallet. YOU generate this, offline.
# See docs/onboarding.md. Never paste a seed anyone else has seen.
LDK_MNEMONIC=""

# HTTP port for the whole API. 8090 avoids lnd's REST default of 8080,
# which is already taken on RaspiBlitz and most lnd boxes.
HEALTH_PORT="8090"

# Exactly how the outside world reaches this daemon, e.g.
# https://node.example.com (the tunnel or proxy hostname, docs/tunnel.md).
# NIP-98 auth and LNURL callbacks verify against this URL.
PUBLIC_URL=""

# Chain source: pick ONE of the next two.
# Esplora: zero infrastructure, but a public explorer sees your queries.
ESPLORA_URL="https://blockstream.info/api"
# Your own bitcoind: uncomment to use it instead (it wins over Esplora).
#BITCOIND_RPC_URL="http://rpcuser:rpcpass@127.0.0.1:8332"

# Hex Nostr pubkey allowed to upload products (your publishing key,
# the one the desktop app signs with). Uploads are disabled when empty.
ARTIST_PUBKEY=""

# Hex Nostr pubkey of the OPERATOR key for the admin API (funding address,
# on-chain sends, channel orders). Use a different key than ARTIST_PUBKEY:
# the key that signs your music must not be able to spend your funds.
ADMIN_PUBKEY=""

# The Lightning address this node answers for, e.g. you@node.example.com.
# The name part is what wallets type; the host must serve this daemon.
LNURL_ADDRESS=""

# LSPS1 provider for buying inbound channels (docs/onboarding.md).
LSPS1_API_URL="https://megalithic.me/api/lsps1/v1"

# The provider's node as pubkey@host:port. Connected at startup and
# trusted for 0-conf channel opens. Get the current URI from the provider.
LSPS1_NODE_URI=""
